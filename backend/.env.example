# docker compose 读取同目录下的 .env。复制一份再改：cp .env.example .env
# .env 已被 .gitignore / .dockerignore 排除，不会进 Git 和镜像。
# 口令只用字母和数字：它们会被拼进数据库 DSN 和 redis:// URI，特殊字符会破坏格式。

# —— 依赖服务（完整模式和依赖模式都需要）——
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
# MinIO 要求至少 8 位
MINIO_ROOT_PASSWORD=

# —— 后端（仅完整模式）——
# 首次启动播种 admin 账号的密码，须满足口令复杂度：至少 8 位且包含大写、小写、数字、符号中的 3 类。
# 只在空库首次播种时生效，之后改密请在系统里改。
GWA_ADMIN_INITIAL_PASSWORD=

# JWT 签名私钥（PEM，多行，整体用双引号包起来）。完整模式必填，每个部署单独生成，公钥由私钥派生。
# 填 configs/auth.yaml 里的示例私钥会拒绝启动。在 backend/ 下执行这两行生成并写入 .env：
#   sed -i.bak '/^GWA_AUTH_JWT_PRIVATE_KEY=/d' .env
#   printf 'GWA_AUTH_JWT_PRIVATE_KEY="%s"\n' "$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048)" >> .env
GWA_AUTH_JWT_PRIVATE_KEY=

# 可选：签名图片 URL（富文本内嵌图片）使用的 HMAC 密钥。不填则富文本图片无法内嵌预览。
GOWIND_CRYPTO_KEY=

# 可选：前端 nginx 映射到宿主机的端口，默认 80
HTTP_PORT=
