# 环境变量配置文件
VITE_ENV=pro

# API 基础地址。生产默认同源：前端 nginx 把 /admin/ 反代到后端
# （scripts/deploy/nginx.conf，Docker 构建时 Dockerfile 也写死同样的值）。
# 前后端分域部署时改成后端的完整地址，例如 https://api.example.com
VITE_API_URL="/"

# SSE 地址。同源时由 nginx 的 location = /events 反代到 SSE 网关；
# 分域部署时改成完整地址，例如 https://sse.example.com/events
VITE_SSE_URL="/events"
